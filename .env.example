# Copie este arquivo para .env e preencha. O .env NUNCA vai para o git.
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional
GEMINI_MODEL=gemini-3.6-flash
# Tentados em ordem se o principal estiver sobrecarregado (separe por vírgula)
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash
PORT=8000

# Ao publicar (Render, Railway...): 1 para limitar por testador, não pelo proxy
TRUST_PROXY=0
# Máximo de perguntas por dia somando todos os testadores
DAILY_LIMIT=300
